# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Model weights are large binaries: download them separately (see README)
*.pt
*.pth

# Local env files
.env

# Training data, environments and run outputs (large)
data/
.venv-train/
training/runs/**/*.pt
# The trained hybrids ship with the app (49 MB each: 224 px and 288 px)
!Flask Deployed App/leafscan_hybrid.pt
!Flask Deployed App/leafscan_hybrid_288.pt

# Browser version: build output and exported ONNX models (built by .github/workflows/pages.yml)
_site/
*.onnx

# Demo: the raw screen recording is re-made by demo/record_browser.py (the assembled video is kept)
demo/browser/*.webm

# Packaging build output (pip install -e .)
*.egg-info/
build/

# Failure-case photo galleries: web-sourced (some watermarked) photos, regenerated by surveillance.failure_cases
surveillance/results/local_only/
